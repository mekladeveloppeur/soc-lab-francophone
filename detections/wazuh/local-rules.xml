<!--
  Exemple pédagogique uniquement. À intégrer et tester dans un Wazuh de laboratoire.
  Le décodeur doit normaliser le résultat d'authentification et l'adresse source.
  Les IDs de règle locaux doivent être vérifiés avant toute intégration.
-->
<group name="local,authentication_failed,">
  <rule id="100101" level="5">
    <decoded_as>json</decoded_as>
    <field name="outcome">failure</field>
    <description>Échec d'authentification observé dans le laboratoire</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100102" level="10" frequency="5" timeframe="600">
    <if_matched_sid>100101</if_matched_sid>
    <same_field>source_ip</same_field>
    <description>Au moins cinq échecs d'authentification depuis la même source en dix minutes</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,brute_force,</group>
  </rule>
</group>
